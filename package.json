{
  "name": "chess-clock",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --fail-on-warnings --tsconfig ./tsconfig.json --watch",
    "test:e2e": "playwright test --workers=1",
    "test:cv": "node tests/chessboard_localization.test.js",
    "test:occupancy": "node tests/chessboard_occupancy.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "husky": "^9.1.7",
    "jimp": "^1.6.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "qrcode": "^1.5.4"
  }
}
